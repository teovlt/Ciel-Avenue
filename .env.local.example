# Variables d'environnement SERVEUR pour Vercel
# 
# ⚠️  NE PAS committer le vrai fichier .env.local avec les clés !
#
# Ces variables sont utilisées par les fonctions serverless (api/)
# Elles NE SONT PAS exposées au navigateur (sécurisé)
#
# === CONFIGURATION ===
#
# 1. Pour tester localement avec `pnpm dev`:
#    Copier ce fichier en .env.local et remplir les valeurs
#
# 2. Pour la production Vercel:
#    Dashboard Vercel > Settings > Environment Variables
#
# === VARIABLES ===

# Clé API Groq pour le chatbot en PRODUCTION (GRATUIT - https://console.groq.com)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxx

# Clé API Groq pour le développement LOCAL (préfixe VITE_ pour être accessible côté client)
# En dev, cette clé est exposée au frontend. En prod, seule GROQ_API_KEY (côté serveur) est utilisée.
VITE_GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxx